# OpenAI Cloud Production Profile
APP_LOCALE=en
STORAGE_BACKEND=postgres
POSTGRES_DSN=postgresql://postgres:postgres@localhost:5432/ops_copilot

# Hardened API Auth (disable demo token endpoint in production)
AUTH_MODE=token
AUTH_SECRET=replace-with-32-byte-random-hex-secret
ALLOW_DEMO_TOKENS=false

# Official OpenAI API Configuration
LLM_BASE_URL=https://api.openai.com/v1
LLM_API_KEY=sk-proj-your-openai-api-key
LLM_MODEL=gpt-4.1-mini
ROUTER_FAST_MODEL=gpt-4.1-mini
ROUTER_STRONG_MODEL=gpt-4.1
LLM_TEMPERATURE=0.0
LLM_MAX_TOKENS=2048
LLM_TIMEOUT_SECONDS=60
EMBEDDING_MODEL=text-embedding-3-small

# RAG Retrieval Settings
RAG_TOP_K=4
RAG_MAX_CONTEXT_CHARS=3500

# OpenTelemetry / Langfuse OTLP Ingest
OTEL_EXPORT_JSONL_PATH=data/otel_spans.jsonl
# OTEL_EXPORTER_OTLP_ENDPOINT=https://cloud.langfuse.com/api/public/otel/v1/traces
