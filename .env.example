# Application Locale & Storage Backend
APP_LOCALE=en
STORAGE_BACKEND=sqlite
# POSTGRES_DSN=postgresql://postgres:postgres@localhost:5432/ops_copilot

# API Gateway Auth (stateless HMAC-signed Bearer token)
AUTH_MODE=token
AUTH_SECRET=dev-ops-copilot-secret-change-in-prod
ALLOW_DEMO_TOKENS=true

# OpenAI-compatible inference endpoint (Ollama local by default)
LLM_BASE_URL=http://127.0.0.1:11434/v1
LLM_API_KEY=ollama
LLM_MODEL=qwen3:8b
ROUTER_FAST_MODEL=qwen3:8b
ROUTER_STRONG_MODEL=qwen3:14b
LLM_TEMPERATURE=0.0
LLM_MAX_TOKENS=2048
LLM_TIMEOUT_SECONDS=120
OLLAMA_NUM_CTX=16384
EMBEDDING_MODEL=bge-m3

# SQLite storage paths (used when STORAGE_BACKEND=sqlite)
RAG_DB_PATH=data/knowledge.db
OPS_DB_PATH=data/ops.db
CHECKPOINT_DB_PATH=data/checkpoints.db
TRACE_DB_PATH=data/traces.db

# RAG Retrieval Settings
RAG_TOP_K=4
RAG_MAX_CONTEXT_CHARS=3500

# Optional OpenTelemetry / Langfuse-compatible Span Export
# OTEL_EXPORT_JSONL_PATH=data/otel_spans.jsonl
# OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4318/v1/traces
